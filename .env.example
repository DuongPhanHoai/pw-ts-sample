# LM Studio (OpenAI-compatible local server)
LMSTUDIO_BASE_URL=http://192.168.1.166:1234/v1
LMSTUDIO_MODEL=google/gemma-4-e4b
LMSTUDIO_TIMEOUT_SECONDS=120
# LLM exchanges logged to reports/llm-prompts/ by default (set LMSTUDIO_LOG_LLM=false to disable)
# Verbose console dump of full prompts/responses:
# LMSTUDIO_LOG_PROMPTS=true
# Analyze only first N failures (for testing)
# LMSTUDIO_FAILURE_LIMIT=3
LMSTUDIO_MAX_ERROR_CHARS=2000
# 1 = one failed test per LLM call (recommended). Increase only if your model handles larger batches well.
LMSTUDIO_BATCH_SIZE=1
# Optional USD cost estimation (per 1M tokens). Leave unset for token counts only.
# LMSTUDIO_COST_PER_1M_INPUT=0
# LMSTUDIO_COST_PER_1M_OUTPUT=0
# LM Studio accepts any non-empty API key
LMSTUDIO_API_KEY=lm-studio

# Playwright environment (dev = fast smoke, test = full matrix)
TEST_ENV=dev

# Auto-heal: false | dry-run | true
AUTO_FIX_TESTS=false
