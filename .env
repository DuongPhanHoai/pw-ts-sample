# LM Studio (OpenAI-compatible local server)
LMSTUDIO_BASE_URL=http://192.168.1.166:1234/v1
LMSTUDIO_MODEL=google/gemma-4-e4b
LMSTUDIO_TIMEOUT_SECONDS=120
LMSTUDIO_MAX_ERROR_CHARS=2000
LMSTUDIO_API_KEY=lm-studio

# Debug: log exact payloads sent to LM Studio (reports/llm-prompts/)
LMSTUDIO_LOG_PROMPTS=true
LMSTUDIO_LOG_LLM=true
# Analyze only first N failures (remove or comment out for full run)
LMSTUDIO_FAILURE_LIMIT=300

# Playwright environment (dev = fast smoke, test = full matrix)
TEST_ENV=dev

# Auto-heal: false | dry-run | true
AUTO_FIX_TESTS=true

LMSTUDIO_MODEL_g12b=google/gemma-4-12b-qat
LMSTUDIO_MODEL_g4b=google/gemma-4-e4b
LMSTUDIO_MODEL_q9b=qwen/qwen3.5-9b
